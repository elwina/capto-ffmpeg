# Pinned build inputs — bump deliberately, rebuild & re-audit DLLs.

ZIG_VERSION=0.16.0
FFMPEG_TAG=n9.0
X264_REF=stable
# FFmpeg 9.0 wants ffnvcodec >= 12.1.14.0; pin current line.
FFNVCODEC_TAG=n13.1.15.0
# GPUOpen AMF headers (tag or commit) — runtime LoadLibrary, headers only
AMF_TAG=v1.5.2
# Intel VPL dispatcher only (open-source hook); GPU runtime loaded at encode time
LIBVPL_TAG=v2.13.0

# Target triple for zig cc / package naming
TARGET=x86_64-windows-gnu
# Filename alias for Capto Tauri externalBin (ABI is still mingw/gnu)
TAURI_BIN_ALIAS=ffmpeg-x86_64-pc-windows-msvc.exe
